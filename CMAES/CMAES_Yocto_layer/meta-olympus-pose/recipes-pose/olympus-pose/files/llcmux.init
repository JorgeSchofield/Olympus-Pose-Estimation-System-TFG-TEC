#!/bin/sh
### BEGIN INIT INFO
# Provides:          llcmux
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Olympus LLC link multiplexer (agents/DESIGN.md §6)
# Description:       Owns /dev/arduino_mega_hw; gives olympus_hlc /dev/arduino_mega
#                    (without RAW: lines) and olympus-pose /run/olympus/llc_raw.
### END INIT INFO
#
# Must run before olympus_hlc is started: /dev/arduino_mega only exists while
# llcmux runs. Restarted automatically if it exits (sysvinit has no respawn
# for services, so a small loop does it). Options in /etc/default/llcmux.

NAME=llcmux
DAEMON=/usr/bin/llcmux
PIDFILE=/run/llcmux.pid
LOG=/var/log/llcmux.log
LLCMUX_ARGS=""
[ -r /etc/default/llcmux ] && . /etc/default/llcmux

[ -x "$DAEMON" ] || exit 0

running() {
	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
	if running; then
		echo "$NAME already running"
		return 0
	fi
	echo "Starting $NAME"
	(
		trap 'exit 0' TERM
		while true; do
			$DAEMON $LLCMUX_ARGS >>"$LOG" 2>&1
			rc=$?
			# exit code 1: cannot create the ptys -> retrying will not help
			[ $rc -eq 1 ] && { echo "$(date) llcmux exited with 1, not restarting" >>"$LOG"; exit 1; }
			sleep 1
		done
	) </dev/null &
	echo $! >"$PIDFILE"
}

stop() {
	echo "Stopping $NAME"
	if running; then
		kill -TERM "$(cat "$PIDFILE")" 2>/dev/null
	fi
	killall -TERM $NAME 2>/dev/null
	rm -f "$PIDFILE"
	sleep 1
}

case "$1" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
status) if running; then echo "$NAME running"; else echo "$NAME stopped"; exit 3; fi ;;
*) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
