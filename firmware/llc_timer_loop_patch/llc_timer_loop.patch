+// ─── [PATCH timer-loop] Base de tiempo de 1 ms (Timer0 overflow) ─────────────
+//
+// Problema que resuelve: el loop terminaba con delay_ms(LOOP_MS), así que cada
+// ciclo duraba LOOP_MS + el trabajo del ciclo (IMU, TX bloqueante de la trama
+// RAW, ADC, TLM...), y el timestamp `elapsed_ms` sumaba 20 por ciclo aunque el
+// ciclo durara 28–49 ms. Medido en el rover: 34 Hz y un reloj del LLC al 68 %
+// del tiempo real (llc_clock_scale = 1.465). Ver README.md del parche.
+//
+// Solución: un contador de milisegundos reales alimentado por la interrupción
+// de desborde del Timer0, como millis() de Arduino.
+//
+// Timer0 en modo Fast PWM de 8 bits con prescaler 64:
+//   desborde cada 64 × 256 / 16 MHz = 1024 µs = 1 ms + 24 µs.
+// Cada desborde suma 1 ms y acumula 24 µs en una fracción guardada en
+// unidades de 8 µs (24/8 = 3, 1000/8 = 125); cuando la fracción llega a
+// 1 ms se suma un ms extra. Error acumulado nulo (salvo el del cristal).
+//
+// El Timer0 ya corre así en los builds `mixed-drivers` y `all-bts7960`
+// (Timer0Pwm::new(dp.TC0, Prescale64), PWM de D4/OC0B y D13/OC0A): habilitar
+// su interrupción de desborde NO cambia el PWM. En los builds que no usan el
+// Timer0 para PWM, timebase_init() lo configura igual, sin salidas.
+
+/// Registros del Timer0 (direcciones de data memory del ATmega2560).
+const TCCR0A_ADDR: *mut u8 = 0x44 as *mut u8; // COM0A/COM0B (salidas PWM) y WGM01:0
+const TCCR0B_ADDR: *mut u8 = 0x45 as *mut u8; // WGM02 y prescaler CS02:0
+const TIMSK0_ADDR: *mut u8 = 0x6E as *mut u8; // bit 0 = TOIE0 (interrupción de desborde)
+
+/// Milisegundos reales desde timebase_init(). Desborda cada ~49.7 días, igual
+/// que el `elapsed_ms` anterior; el HLC ya resta los ticks con aritmética u32.
+static MILLIS: avr_device::interrupt::Mutex<core::cell::Cell<u32>> =
+    avr_device::interrupt::Mutex::new(core::cell::Cell::new(0));
+/// Fracción de ms acumulada, en unidades de 8 µs (0..124).
+static MILLIS_FRAC: avr_device::interrupt::Mutex<core::cell::Cell<u8>> =
+    avr_device::interrupt::Mutex::new(core::cell::Cell::new(0));
+
+/// ISR de desborde del Timer0: cada 1024 µs.
+#[avr_device::interrupt(atmega2560)]
+fn TIMER0_OVF() {
+    avr_device::interrupt::free(|cs| {
+        let ms_cell = MILLIS.borrow(cs);
+        let frac_cell = MILLIS_FRAC.borrow(cs);
+        let mut ms = ms_cell.get().wrapping_add(1);
+        let mut frac = frac_cell.get() + 3; // 24 µs = 3 × 8 µs
+        if frac >= 125 {                    // 125 × 8 µs = 1 ms
+            frac -= 125;
+            ms = ms.wrapping_add(1);
+        }
+        ms_cell.set(ms);
+        frac_cell.set(frac);
+    });
+}
+
+/// Milisegundos reales desde el arranque (lectura atómica del contador de 32 bits).
+fn millis() -> u32 {
+    avr_device::interrupt::free(|cs| MILLIS.borrow(cs).get())
+}
+
+/// Configura el Timer0 como base de tiempo (Fast PWM 8 bits, prescaler 64) y
+/// habilita su interrupción de desborde. Llamar DESPUÉS de crear los Timer*Pwm
+/// y ANTES de `avr_device::interrupt::enable()`.
+///
+/// Lectura-modificación-escritura: no toca COM0A/COM0B, de modo que el PWM de
+/// los pines del Timer0 sigue igual en los builds que lo usan.
+fn timebase_init() {
+    unsafe {
+        // TCCR0A: WGM01 = 1, WGM00 = 1 → Fast PWM, TOP = 0xFF. Bits COM intactos.
+        let a = core::ptr::read_volatile(TCCR0A_ADDR);
+        core::ptr::write_volatile(TCCR0A_ADDR, a | 0b0000_0011);
+        // TCCR0B: WGM02 = 0, CS02:0 = 011 → prescaler 64. FOC0A/B quedan en 0.
+        let b = core::ptr::read_volatile(TCCR0B_ADDR);
+        core::ptr::write_volatile(TCCR0B_ADDR, (b & !0b0000_1111) | 0b0000_0011);
+        // TIMSK0: TOIE0 = 1.
+        let m = core::ptr::read_volatile(TIMSK0_ADDR);
+        core::ptr::write_volatile(TIMSK0_ADDR, m | 0b0000_0001);
+    }
+}
