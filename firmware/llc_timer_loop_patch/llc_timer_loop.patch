+// ─── [PATCH timer-loop] Desfase de las tareas lentas ─────────────────────────
+//
+// Cada tarea periódica lleva un contador que se incrementa al inicio de su
+// bloque y dispara cuando llega a su periodo. Con todos los contadores en 0,
+// el ciclo 50 ejecutaba a la vez el HC-SR04 (cada 5), la lectura analógica
+// completa (cada 25, ~10.8 ms bloqueantes) y la TLM (cada 50, ~8.7 ms de TX
+// bloqueante): ese ciclo duraba ~49 ms (máximo medido en el rover).
+//
+// Arrancando los contadores con un desfase, cada tarea dispara en ciclos
+// distintos. Un contador que arranca en F con periodo P dispara por primera
+// vez en el ciclo P − F y luego cada P ciclos:
+//   HC-SR04   (fase 0):  ciclos ≡ 0  (mód 5)
+//   analógico (fase 2):  ciclos ≡ 23 (mód 25)  → ≡ 3 (mód 5): nunca con el HC
+//   TLM       (fase 37): ciclos ≡ 13 (mód 50)  → ≡ 3 (mód 5) y ≡ 13 (mód 25):
+//                        nunca con el HC ni con la lectura analógica
+// Peor ciclo esperado ≈ 8 ms (IMU + TX de la trama RAW) + 10.8 ms (analógico)
+// ≈ 18.8 ms, dentro del periodo de 20 ms.
+
+/// Valor inicial de `sen_counter` (lectura analógica completa).
+pub const SEN_PHASE: u8 = 2;
+
+/// Valor inicial de `tlm_counter` (telemetría periódica).
+pub const TLM_PHASE: u8 = 37;
+
+// Comprobación en compilación: si alguien cambia un periodo o una fase de forma
+// que dos tareas lentas vuelvan a coincidir, el firmware no compila.
+// La prueba es exacta mientras TLM_PERIOD sea múltiplo de SEN_READ_PERIOD y
+// ambos lo sean de HC_READ_PERIOD (también se verifica aquí).
+const _: () = {
+    let tlm_first = TLM_PERIOD - TLM_PHASE;      // ciclo del primer disparo de TLM
+    let sen_first = SEN_READ_PERIOD - SEN_PHASE; // ídem lectura analógica
+    assert!(TLM_PHASE < TLM_PERIOD && SEN_PHASE < SEN_READ_PERIOD);
+    assert!(TLM_PERIOD % SEN_READ_PERIOD == 0 && SEN_READ_PERIOD % HC_READ_PERIOD == 0);
+    assert!(sen_first % HC_READ_PERIOD != 0);                  // analógico ≠ HC-SR04
+    assert!(tlm_first % HC_READ_PERIOD != 0);                  // TLM ≠ HC-SR04
+    assert!(tlm_first % SEN_READ_PERIOD != sen_first % SEN_READ_PERIOD); // TLM ≠ analógico
+};
